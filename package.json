{
  "name": "pm-brand",
  "version": "2026.10.17",
  "description": "The Triplicate brand kit for pm: design tokens, fonts, mark and icons shared by every pm surface",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-brand.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./logo/*": "./logo/*",
    "./icons/*": "./icons/*",
    "./CONTRACT.md": "./CONTRACT.md",
    "./package.json": "./package.json",
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.js",
      "default": "./dist/banner.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.js",
      "default": "./dist/og.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js",
      "default": "./dist/contrast.js"
    }
  },
  "files": [
    "dist/",
    "tokens.css",
    "fonts.css",
    "fonts/",
    "logo/",
    "icons/",
    "CONTRACT.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/contrast.md",
    "banners/"
  ],
  "devDependencies": {
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@unbrained/pm-cli": "2026.10.20",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "pm-changelog": "2026.10.20",
    "pm-ops": "2026.10.20",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "node scripts/prepare.ts",
    "prepack": "npm run build",
    "fonts:build": "node scripts/fonts.ts && node scripts/font-paths.ts",
    "assets:build": "node scripts/marks.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/*.test.ts",
    "lint": "node scripts/lint.ts",
    "docstring": "node scripts/docstrings.ts",
    "coverage": "npm run build && node scripts/coverage.ts",
    "font-budget": "node scripts/font-budget.ts",
    "identity:check": "node scripts/identity.ts",
    "audit:prod": "node scripts/audit.ts",
    "pack:dry-run": "node scripts/pack.ts",
    "prepublishOnly": "npm run release:check",
    "changelog": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --no-pending-release --status closed,in_progress --item-url-base https://github.com/unbraind/pm-brand/blob/main/.agents/pm --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:full": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --no-pending-release --status closed,in_progress --item-url-base https://github.com/unbraind/pm-brand/blob/main/.agents/pm --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:check": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --no-pending-release --status closed,in_progress --item-url-base https://github.com/unbraind/pm-brand/blob/main/.agents/pm --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --check",
    "release:notes": "pm-changelog --pm-root .agents/pm --mode replace --stdout --all-release-tags --no-pending-release --status closed,in_progress --item-url-base https://github.com/unbraind/pm-brand/blob/main/.agents/pm --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "release:check": "npm run identity:check && pm health --strict-exit --require-merge-drivers && npm run typecheck && npm run lint && npm run build:check && npm run build && npm run docstring && npm run font-budget && npm run assets:check && npm run banners:check && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run changelog:check && npm run test:install",
    "test:install": "node scripts/acceptance.ts",
    "assets:check": "node scripts/assets-check.ts",
    "build:check": "node scripts/dist-check.ts",
    "test:git": "node scripts/git-acceptance.ts",
    "banners:build": "npm run build && node scripts/banners.ts",
    "banners:check": "node scripts/banners.ts --check"
  },
  "docstringGate": {
    "sources": [
      "src",
      "scripts"
    ]
  },
  "coverageGate": {
    "sources": [
      "src"
    ],
    "tests": [
      "test/*.test.ts"
    ],
    "thresholds": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "ignore": []
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://pm-cli.unbrained.dev/packages/pm-brand",
  "author": {
    "name": "unbrained",
    "url": "https://unbrained.dev/about"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-brand/issues"
  }
}
