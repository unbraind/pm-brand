regression when reverted"},{"op":"add","path":"/metadata/expected_result","value":"Main CI passes after merges that add entry points; the fixture is verified against its own recorded main commit, and the branch is also checked against current main."},{"op":"add","path":"/metadata/actual_result","value":"verify (22) and verify (26) fail on main at 4ffda25: The \"paths[1]\" argument must be of type string. Received undefined (inventoryPublicApi)."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"70d7e4dd1fca77f959b690f6cd86412bbd6300774b2dde56440dcc8c6bdc6399","item_hash_version":3,"message":"explicit_unset=blocked_by,parent","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"784005df1ebc438097bb38311532b79e8469095f5abaf1c39b75a64cc375384b"}
